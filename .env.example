# Public production origin, without a trailing slash, e.g. https://www.example.com
# Used for canonical URLs, hreflang alternates, Open Graph URLs and sitemap.xml.
# Leave empty until the production domain is confirmed: those tags and the sitemap
# are then omitted rather than published with a placeholder domain.
#
# Anything prefixed with VITE_ is embedded in the public bundle. Never put secrets here.
VITE_SITE_URL=

# Public URL of the enquiry API endpoint (POST, JSON). Leave empty until the
# backend exists: the enquiry form then hands over to the visitor's email app
# instead of pretending to submit. This is an address, not a credential.
VITE_ENQUIRY_API_URL=

# ---------------------------------------------------------------------------
# WhatsApp enquiry notifications: server side only (worker/index.js).
#
# These are NOT read from this file and must never get a VITE_ prefix. On
# Cloudflare they are Worker settings: the two secrets are set once with
#   npx wrangler secret put WHATSAPP_ACCESS_TOKEN
#   npx wrangler secret put WHATSAPP_PHONE_NUMBER_ID
# and the other values live in wrangler.jsonc under "vars". For local testing
# with `npx wrangler dev`, copy them into a .dev.vars file (ignored by git).
# See the README, "WhatsApp enquiry notifications".
#
# Permanent (System User) access token from Meta Business Manager. Secret.
# WHATSAPP_ACCESS_TOKEN=
# ID of the business phone number that sends the notifications (not the
# phone number itself), from WhatsApp Manager > API Setup.
# WHATSAPP_PHONE_NUMBER_ID=
# Who receives the notifications, international form without "+".
# WHATSAPP_RECIPIENT_NUMBER=919962034530
# The approved message template and its language code.
# WHATSAPP_TEMPLATE_NAME=website_enquiry
# WHATSAPP_TEMPLATE_LANGUAGE=en
# WHATSAPP_API_VERSION=v23.0
#
# Once the notifications are configured and tested, switch the form over by
# setting (in .env.production):
# VITE_ENQUIRY_API_URL=/api/enquiry
