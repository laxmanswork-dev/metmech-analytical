// Cloudflare deployment config. `npm run build` prerenders every page into
// dist/, and `wrangler deploy` uploads that folder as-is together with the
// small Worker in worker/, which runs only for /api/* (the enquiry API).
// Without this file Wrangler auto-configures the project, adding the
// Cloudflare Vite plugin, which breaks the prerender step of the build.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker's name in the Cloudflare dashboard.
  "name": "metmech-analytical",
  "compatibility_date": "2026-10-01",
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Pages are served without starting the Worker; only the API runs it.
    "run_worker_first": ["/api/*"],
    // Prerendered pages live at <route>/index.html. They are served at the
    // route without a trailing slash, the form used by every canonical URL,
    // hreflang link, sitemap entry and internal link; "/route/" redirects to
    // "/route". (With "auto-trailing-slash", every one of those URLs answered
    // with a redirect to "/route/".)
    "html_handling": "drop-trailing-slash",
    // Unknown URLs get the prerendered dist/404.html with a 404 status.
    "not_found_handling": "404-page"
  },
  "observability": { "enabled": true },
  // WhatsApp enquiry notifications (see README). Not secret. The access token
  // and phone number ID are Worker secrets, set with `wrangler secret put`.
  "vars": {
    "WHATSAPP_RECIPIENT_NUMBER": "919962034530",
    "WHATSAPP_TEMPLATE_NAME": "website_enquiry",
    "WHATSAPP_TEMPLATE_LANGUAGE": "en",
    "WHATSAPP_API_VERSION": "v23.0"
  }
}
